{
  "position": "bottom",
  "height": 30,
  "spacing": 4,
  "reload_style_on_change": true,
  "modules-left": [
    "sway/workspaces",
    "sway/scratchpad",
    "sway/mode",
    "custom/window"
  ],
  "modules-right": [
    "network",
    "custom/wireguard-manager",
    "bluetooth",
    "custom/performance",
    "battery",
    "custom/brightness",
    "pulseaudio",
    "idle_inhibitor",
    "custom/notifications",
    "clock",
    "custom/arch-updates",
    "custom/devices",
    "tray",
    "custom/power"
  ],
  "sway/workspaces": {
    "enable-bar-scroll": true,
    "disable-scroll-wraparound": true
  },
  "sway/scratchpad": {
    "format": "  {count}",
    "show-empty": false
  },
  // Per-output title (sway/window only shows it on the focused output); rewrite rules live in the script
  "custom/window": {
    "exec": "$HOME/.config/waybar/resources/window_title.py",
    "return-type": "json",
    "restart-interval": 2
  },
  "network": {
    "on-click": "$HOME/.config/waybar/resources/control_center.py network",
    "format-wifi": "  {signalStrength}% {essid}",
    "format-ethernet": "󰈀 {ipaddr}",
    "format-disconnected": "",
    "tooltip-format": "{ifname} via {gwaddr} {icon}",
    "format-icons": {
      "wifi": "",
      "ethernet": "󰈀"
    }
  },
  "battery": {
    "tooltip-format": "{timeTo}\nHealth {health}%",
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}% ({time} {power:.1f}w)",
    "format-time": "{H}:{m}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
    "format-charging": " {capacity}% ({time} {power:.1f}w)",
    "interval": 3
  },
  // CPU, temperature, RAM and free disk space as one button; see resources/performance.py
  "custom/performance": {
    "exec": "$HOME/.config/waybar/resources/performance.py",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "$HOME/.config/waybar/resources/control_center.py performance"
  },
  // External drives and phones; see resources/devices.py
  "custom/devices": {
    "exec": "$HOME/.config/waybar/resources/devices.py",
    "return-type": "json",
    "restart-interval": 5,
    "on-click": "$HOME/.config/waybar/resources/control_center.py devices",
    "on-click-right": "nautilus --new-window"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  },
  // DDC/CI monitors or a laptop backlight; see resources/brightness.sh.
  // Shows the monitor this bar is on; scrolling adjusts it, or all of them when linked.
  "custom/brightness": {
    "exec": "$HOME/.config/waybar/resources/brightness.sh status",
    "return-type": "json",
    "interval": "once",
    "signal": 8,
    "hide-empty-text": true,
    "on-click": "$HOME/.config/waybar/resources/control_center.py brightness",
    "on-click-right": "$HOME/.config/waybar/resources/brightness.sh link toggle",
    "on-scroll-up": "$HOME/.config/waybar/resources/brightness.sh up 5",
    "on-scroll-down": "$HOME/.config/waybar/resources/brightness.sh down 5"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "󰂰 {volume}%",
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "tooltip-format": "{desc}",
    "scroll-step": 5,
    "max-volume": 100,
    "on-click": "$HOME/.config/waybar/resources/control_center.py audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-middle": "alacritty --class 'wiremix' --command wiremix --tab output"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Staying awake",
    "tooltip-format-deactivated": "Idle lock enabled"
  },
  "custom/notifications": {
    "exec": "$HOME/.config/waybar/resources/notifications.sh",
    "on-click": "$HOME/.config/waybar/resources/control_center.py notifications",
    "on-click-right": "$HOME/.config/waybar/resources/notifications.sh --toggle",
    "return-type": "json",
    "interval": 10,
    "signal": 9
  },
  "clock": {
    "format": " {:%m-%d  %I:%M}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#BD93F9'><b>{}</b></span>",
        "days": "<span color='#F8F8F2'>{}</span>",
        "weeks": "<span color='#6272A4'>W{}</span>",
        "weekdays": "<span color='#8BE9FD'><b>{}</b></span>",
        "today": "<span color='#FF79C6'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "custom/wireguard-manager": {
    "exec": "bash $HOME/.config/waybar/resources/wireguard-manager.sh -s",
    "on-click": "bash $HOME/.config/waybar/resources/wireguard-manager.sh -t",
    "format": "wg: {icon}",
    "format-icons": {
      "connected": "up",
      "disconnected": "down"
    },
    "return-type": "json",
    "interval": 5,
    "hide-empty-text": true
  },
  "custom/arch-updates": {
    "exec": "bash $HOME/.config/waybar/resources/arch_updates.sh -s",
    "on-click": "bash $HOME/.config/waybar/resources/arch_updates.sh -u",
    "return-type": "json",
    "interval": 3600,
    "signal": 10,
    "hide-empty-text": true
  },
  "bluetooth": {
    "format": " {status}",
    "format-disabled": "",
    "format-connected": " {num_connections} connected",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "$HOME/.config/waybar/resources/control_center.py bluetooth",
    "on-click-right": "alacritty --class 'bluetui' --command 'bluetui'"
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "on-click": "$HOME/.config/waybar/resources/control_center.py power"
  }
}
